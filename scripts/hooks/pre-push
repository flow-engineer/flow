#!/usr/bin/env bash
# Runs gitleaks on the commits being pushed and refuses them if their messages or changes name a
# customer or vendor. The names are kept outside this repository: FLOW_FRAMEWORK_DENY_NAMES
# (comma-separated) or, when that is unset, the file named by FLOW_FRAMEWORK_DENY_FILE (one per line or
# comma-separated); the names from before the rename, CHINWAG_DENY_NAMES and CHINWAG_DENY_FILE, still work. Install once per clone: git config core.hooksPath scripts/hooks
set -euo pipefail

zero=0000000000000000000000000000000000000000

names=$(mktemp)
trap 'rm -f "$names"' EXIT
deny_names=${FLOW_FRAMEWORK_DENY_NAMES:-${CHINWAG_DENY_NAMES:-}}
deny_file=${FLOW_FRAMEWORK_DENY_FILE:-${CHINWAG_DENY_FILE:-}}
if [ -n "$deny_names" ]; then
  printf '%s' "$deny_names" | tr ',' '\n' >"$names"
elif [ -n "$deny_file" ] && [ -f "$deny_file" ]; then
  tr ',' '\n' <"$deny_file" >"$names"
else
  echo "pre-push: no list of customer and vendor names to check against." >&2
  echo "Set FLOW_FRAMEWORK_DENY_NAMES (comma-separated), or FLOW_FRAMEWORK_DENY_FILE to a file outside this repository." >&2
  exit 1
fi
sed -i.bak -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$names" && rm -f "$names.bak"
if [ ! -s "$names" ]; then
  echo "pre-push: the list of names is empty." >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null; then
  echo "pre-push: gitleaks is not installed (brew install gitleaks)." >&2
  exit 1
fi

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  [ -z "$(git rev-list $range)" ] && continue

  if ! gitleaks detect --source . --redact --no-banner --log-opts="$range"; then
    status=1
  fi
  # shellcheck disable=SC2086
  if found=$(git log -p --format='%an %ae%n%B' $range | grep -i -o -F -f "$names" | sort -fu); then
    echo "pre-push: the pushed commits name: $(echo "$found" | paste -sd, -)" >&2
    status=1
  fi
done

exit $status
