{
  "name": "@flow-engineer/flow",
  "version": "0.14.1",
  "description": "An open-source runtime for chat agents that feel like a person texting back.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flow-engineer/flow.git"
  },
  "homepage": "https://github.com/flow-engineer/flow",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./simulators": {
      "types": "./dist/simulators/src/index.d.ts",
      "default": "./dist/simulators/src/index.js"
    },
    "./flow-messaging": {
      "types": "./dist/flow-messaging/src/index.d.ts",
      "default": "./dist/flow-messaging/src/index.js"
    },
    "./web-chat": {
      "types": "./dist/src/web-chat.d.ts",
      "default": "./dist/src/web-chat.js"
    },
    "./testing": {
      "types": "./dist/testing/src/index.d.ts",
      "default": "./dist/testing/src/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/src/index.d.ts",
      "default": "./dist/mcp/src/index.js"
    },
    "./cli": {
      "types": "./dist/cli/src/index.d.ts",
      "default": "./dist/cli/src/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth/src/index.d.ts",
      "default": "./dist/oauth/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "flow": "dist/testing/src/cli.js",
    "chinwag": "dist/testing/src/chinwag.js"
  },
  "files": [
    "dist",
    "examples/cafe/agent",
    "examples/cafe/src",
    "examples/cafe/tests",
    "examples/http-agent",
    "flow-messaging/README.md",
    "docs/agents.md",
    "docs/events.md",
    "docs/guarantees.md",
    "coding-agents",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"for (const f of ['page.html', 'person.html']) fs.copyFileSync('simulators/src/' + f, 'dist/simulators/src/' + f); fs.copyFileSync('testing/src/install.sh', 'dist/testing/src/install.sh')\" && tsc -p widget/tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.ts\" \"widget/test/**/*.test.ts\"",
    "test:changed": "node scripts/test-changed.ts",
    "test:conformance": "node --test --test-timeout=60000 --test-force-exit \"conformance/**/*.test.ts\"",
    "bench:load": "node --expose-gc bench/load.ts",
    "new": "node scripts/new-agent.ts",
    "typecheck": "tsc --noEmit && tsc -p widget/tsconfig.json --noEmit"
  },
  "dependencies": {
    "openai": "^7.32.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@stricli/core": "1.3.0",
    "marked": "12.0.2",
    "marked-terminal": "7.3.0",
    "oidc-provider": "9.12.2",
    "@mariozechner/pi-tui": "0.73.1",
    "esbuild": "0.28.2"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "@stricli/core": {
      "optional": true
    },
    "oidc-provider": {
      "optional": true
    },
    "marked": {
      "optional": true
    },
    "marked-terminal": {
      "optional": true
    },
    "@mariozechner/pi-tui": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@stricli/core": "1.3.0",
    "@types/marked-terminal": "6.1.1",
    "@types/node": "^26.6.5",
    "@types/oidc-provider": "^9.12.1",
    "marked": "12.0.2",
    "marked-terminal": "7.3.0",
    "oidc-provider": "9.12.2",
    "typescript": "^7.0.2",
    "@mariozechner/pi-tui": "0.73.1",
    "esbuild": "0.28.2"
  }
}
